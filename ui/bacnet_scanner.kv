#:import Sidebar ui.widgets.sidebar.Sidebar
#:import NoTransition kivy.uix.screenmanager.NoTransition
#:import colors ui.styles.colors

BoxLayout:
    orientation: 'horizontal'
    
    # Wichtig: Expliziter Hintergrund mit Theme-Farbe
    canvas.before:
        Color:
            rgba: colors.ThemeColors.current["BACKGROUND"]  # Dynamische Themebindung
        Rectangle:
            pos: self.pos
            size: self.size
    
    # Sidebar auf der linken Seite
    Sidebar:
        id: sidebar
        screen_manager: screen_manager
    
    # Hauptinhaltbereich
    AppScreenManager:
        id: screen_manager
        # Falls AppScreenManager keinen eigenen Hintergrund hat, füge hier einen hinzu:
        canvas.before:
            Color:
                rgba: colors.ThemeColors.current["TAB_BACKGROUND"]  # oder eine andere passende Farbe
            Rectangle:
                pos: self.pos
                size: self.size