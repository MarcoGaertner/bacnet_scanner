#:import colors ui.styles.colors
#:import dp kivy.metrics.dp

<KVRow@BoxLayout>:
    key: ""
    value: ""
    size_hint_y: None
    height: dp(36)
    spacing: dp(8)
    Label:
        text: root.key
        color: colors.TEXT_COLOR
        halign: 'left'
        valign: 'middle'
        text_size: self.size
    Label:
        text: root.value
        color: colors.get_color_with_alpha("TEXT_COLOR", 0.85)
        halign: 'left'
        valign: 'middle'
        text_size: self.size

<DeviceDetailsScreen>:
    canvas.before:
        Color:
            rgba: colors.TAB_BACKGROUND
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(12)

        Label:
            markup: True
            text: "[b]"+root.device_name+"[/b]"
            font_size: dp(22)
            color: colors.TEXT_COLOR
            size_hint_y: None
            height: dp(40)
            halign: 'left'
            text_size: self.size

        Label:
            text: "Device-ID: "+str(root.device_id) + ("   |   "+root.address if root.address else "")
            color: colors.get_color_with_alpha("TEXT_COLOR", 0.75)
            size_hint_y: None
            height: dp(24)
            halign: 'left'
            text_size: self.size

        ScrollView:
            do_scroll_x: False
            bar_width: dp(6)
            GridLayout:
                id: details_container
                cols: 2
                size_hint_y: None
                height: self.minimum_height
                width: self.parent.width
                size_hint_x: 1
                row_default_height: dp(30)
                spacing: dp(6)
