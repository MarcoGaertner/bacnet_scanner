#:import colors ui.styles.colors
#:import dp kivy.metrics.dp

<ExportScreen>:
    canvas.before:
        Color:
            rgba: colors.TAB_BACKGROUND
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(12)

        # Kopfzeile
        BoxLayout:
            size_hint_y: None
            height: dp(40)

            Label:
                text: "Export"
                font_size: dp(24)
                color: colors.TEXT_COLOR
                halign: 'left'
                valign: 'middle'
                text_size: self.size

        # Formatwahl + Aktionen
        BoxLayout:
            size_hint_y: None
            height: dp(44)
            spacing: dp(12)

            # Radio-Gruppe Container (nimmt den Platz links ein)
            BoxLayout:
                id: format_group_container
                orientation: 'horizontal'
                spacing: dp(10)
                size_hint_x: 1
                size_hint_y: None
                height: self.minimum_height

            # Aktionen rechts
            Button:
                text: "Exportieren"
                size_hint_x: None
                width: dp(150)
                height: dp(36)
                background_normal: ''
                background_color: colors.HIGHLIGHT_COLOR
                color: 1,1,1,1
                on_release: root.export_now()

            HeaderIconButton:
                id: settings_btn
                size_hint: None, None
                size: dp(36), dp(36)
                source: 'ui/assets/icons/settings.ico'
                on_release: root.open_settings()

        # Vorschau-Bereich
        BoxLayout:
            id: preview_host
            orientation: 'vertical'
            size_hint_y: 1
            padding: dp(10)

            canvas.before:
                Color:
                    rgba: 1, 1, 1, 1
                Rectangle:
                    pos: self.pos
                    size: self.size
