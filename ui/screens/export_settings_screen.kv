#:import colors ui.styles.colors
#:import dp kivy.metrics.dp

<ExportSettingsScreen>:
    canvas.before:
        Color:
            rgba: colors.TAB_BACKGROUND
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(12)

        BoxLayout:
            size_hint_y: None
            height: dp(40)
            Label:
                text: "Export-Einstellungen"
                font_size: dp(24)
                color: colors.TEXT_COLOR
                halign: 'left'
                text_size: self.size
            Button:
                text: "Speichern"
                size_hint_x: None
                width: dp(140)
                on_release: root.save_and_back()

        # Legende
        BoxLayout:
            size_hint_y: None
            height: dp(28)
            spacing: dp(8)
            Label:
                text: "Aktiv"
                color: colors.TEXT_COLOR
            Label:
                text: "Feldname"
                color: colors.TEXT_COLOR
            Label:
                text: "Key"
                color: colors.TEXT_COLOR

        ScrollView:
            bar_width: dp(6)
            GridLayout:
                id: fields_container
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(4)
