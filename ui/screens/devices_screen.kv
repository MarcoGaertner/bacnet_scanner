#:import ThemeColors ui.styles.colors.ThemeColors
#:import colors ui.styles.colors
#:import dp kivy.metrics.dp

<DeviceRow>:
    padding: [dp(10), 0, dp(10), 0]
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: colors.CARD_BACKGROUND if self.index % 2 else colors.TAB_BACKGROUND
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        spacing: dp(2)
        
        # Hauptzeile mit Name und ID
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(24)
            
            # Name fett
            Label:
                markup: True
                text: '[b]'+root.name+'[/b]'
                color: colors.TEXT_COLOR
                halign: 'left'
                valign: 'middle'
                text_size: self.size
                size_hint_x: 0.7
            
            # Device-ID
            Label:
                text: 'ID: '+str(root.device_id)
                color: colors.get_color_with_alpha("TEXT_COLOR", 0.85)
                halign: 'right'
                valign: 'middle'
                text_size: self.size
                size_hint_x: 0.3
        
        # Zusätzliche Informationen (falls vorhanden)
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(20) if root.description or root.location or root.address else dp(0)
            opacity: 0.75
            
            Label:
                text: (root.description + " | " if root.description else "") + (root.location + " | " if root.location else "") + (root.address if root.address else "")
                color: colors.get_color_with_alpha("TEXT_COLOR", 0.7)
                halign: 'left'
                valign: 'middle'
                text_size: self.size
                font_size: dp(11)

<DevicesScreen>:
    canvas.before:
        Color:
            rgba: ThemeColors.current["BACKGROUND"]
        Rectangle:
            pos: self.pos
            size: self.size