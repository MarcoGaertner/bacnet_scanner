#:import colors ui.styles.colors
#:import dp kivy.metrics.dp

<DeviceRow>:
    size_hint_y: None
    height: dp(48)
    padding: [dp(10), 0, dp(10), 0]
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: colors.CARD_BACKGROUND if self.index % 2 else colors.TAB_BACKGROUND
        Rectangle:
            pos: self.pos
            size: self.size

    # Name fett
    Label:
        markup: True
        text: '[b]'+root.name+'[/b]'
        color: colors.TEXT_COLOR
        halign: 'left'
        valign: 'middle'
        text_size: self.size
    # Device-ID
    Label:
        text: 'ID: '+str(root.device_id)
        color: colors.get_color_with_alpha("TEXT_COLOR", 0.85)
        halign: 'left'
        valign: 'middle'
        text_size: self.size

<DevicesScreen>:
    canvas.before:
        Color:
            rgba: colors.TAB_BACKGROUND
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(12)

        Label:
            text: "Geräte"
            font_size: dp(24)
            color: colors.TEXT_COLOR
            size_hint_y: None
            height: dp(40)
            halign: 'left'
            text_size: self.size

        # Optional: Scan-ID anzeigen
        Label:
            text: "Scan #"+str(root.scan_id) if root.scan_id else ""
            color: colors.get_color_with_alpha("TEXT_COLOR", 0.75)
            size_hint_y: None
            height: dp(24)
            halign: 'left'
            text_size: self.size

        ScrollView:
            do_scroll_x: False
            bar_width: dp(6)
            GridLayout:
                id: device_list_container
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                width: self.parent.width
                size_hint_x: 1
                spacing: dp(2)

    BoxLayout:
        size_hint_y: None
        height: dp(40)
        spacing: dp(8)

        Label:
            text: "Geräte"
            font_size: dp(24)
            color: colors.TEXT_COLOR
            size_hint_x: 1
            halign: 'left'
            text_size: self.size

        Button:
            text: "Exportieren"
            size_hint_x: None
            width: dp(160)
            on_release: root.open_export_screen()
