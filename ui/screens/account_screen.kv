#:import colors ui.styles.colors
#:import _ core.i18n.translator._

<AccountScreen>:
    canvas.before:
        Color:
            rgba: colors.TAB_BACKGROUND
        Rectangle:
            pos: self.pos
            size: self.size
    
    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(15)
        
        Label:
            text: root.screen_title
            font_size: dp(24)
            color: colors.HIGHLIGHT_COLOR
            size_hint_y: None
            height: dp(40)
            halign: 'left'
            text_size: self.size
            valign: 'middle'
        
        ScrollView:
            do_scroll_x: False
            
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(15)
                
                ExpandablePanel:
                    id: name_dropdown
                    title: _("account.name")
                
                ExpandablePanel:
                    id: phone_dropdown
                    title: _("account.phone")
                
                ExpandablePanel:
                    id: email_dropdown
                    title: _("account.email")
                
                ExpandablePanel:
                    id: company_dropdown
                    title: _("account.company")
                
                Widget:
                    size_hint_y: None
                    height: dp(20)