#:import colors ui.styles.colors

<TabButton>:
    size_hint: 1, None
    height: dp(50)
    background_normal: ''
    background_down: ''
    background_color: colors.SIDEBAR_ITEM_SELECTED if self.is_selected else colors.SIDEBAR_ITEM
    
    canvas.before:
        Color:
            rgba: self.background_color
        Rectangle:
            pos: self.pos
            size: self.size
    
    BoxLayout:
        pos: root.pos  # Diese Zeile hinzufügen
        size: root.size  # Diese Zeile hinzufügen
        orientation: 'horizontal'
        spacing: dp(10)  # Von 12 auf 10 reduziert
        padding: dp(10)  # Einfacheres Padding
        
        Label:
            size_hint_x: None
            width: dp(30)  # Von 32 auf 30 reduziert
            text: root.icon
            font_size: dp(18)  # Von 24 auf 18 reduziert
            color: colors.SIDEBAR_TEXT
        
        Label:
            size_hint_x: 1
            text: root.tab_text
            font_size: dp(16)
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            color: colors.SIDEBAR_TEXT
            opacity: 1 if root.parent.parent.is_expanded else 0
            # Die size_hint Anpassung beibehalten:
            size_hint_x: 1 if root.parent.parent.is_expanded else 0

<Sidebar>:
    orientation: 'vertical'
    size_hint_x: 0.25 if self.is_expanded else 0.08
    padding: dp(2)
    spacing: dp(2)
    canvas.before:
        Color:
            rgba: colors.SIDEBAR_BACKGROUND
        Rectangle:
            pos: self.pos
            size: self.size
    
    # Space oben hinzufügen
    Widget:
        size_hint_y: 0.1
    
    # Tabs Layout - mit flex-grow in der Mitte
    BoxLayout:
        id: tabs_layout
        orientation: 'vertical'
        size_hint_y: 0.7  # Anteil des verfügbaren Platzes
        spacing: dp(5)  # Etwas mehr Abstand zwischen den Tabs
        
        TabButton:
            icon: "W"  # WiFi Icon
            tab_text: "Verbindung"
            
        TabButton:
            icon: "G"  # Microchip Icon
            tab_text: "Geräte"
            
        TabButton:
            icon: "K"  # User Icon
            tab_text: "Konto"
            
        TabButton:
            icon: "E"  # Gear Icon
            tab_text: "Einstellungen"
            
        TabButton:
            icon: "F"  # File Icon
            tab_text: "Dateien"
            
        TabButton:
            icon: "T"  # Line Chart Icon
            tab_text: "Online-Trend"
            
        TabButton:
            icon: "H"  # Question Circle Icon
            tab_text: "Hilfe"
            
        TabButton:
            icon: "I"  # Info Circle Icon
            tab_text: "Info"
    
    # Flex-Space für die vertikale Zentrierung
    Widget:
        size_hint_y: 0.12
    
    # Reduzieren-Button am unteren Rand
    Button:
        size_hint_y: 0.08
        text: '<< Reduzieren' if root.is_expanded else '>>'
        background_normal: ''
        background_color: colors.SIDEBAR_ITEM
        color: colors.SIDEBAR_TEXT
        on_release: root.toggle_sidebar()