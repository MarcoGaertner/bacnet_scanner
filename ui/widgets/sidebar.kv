#:import colors ui.styles.colors
#:import _ core.i18n.translator._

<TabButton>:
    size_hint: 1, None
    height: dp(50)
    background_normal: ''
    background_down: ''
    background_color: self.background_color_selected if self.is_selected else self.background_color_normal
    
    canvas.before:
        Color:
            rgba: self.background_color
        Rectangle:
            pos: self.pos
            size: self.size
    
    BoxLayout:
        pos: root.pos
        size: root.size
        orientation: 'horizontal'
        spacing: dp(10)
        padding: dp(10)
        
        Image:
            size_hint_x: None
            width: dp(30)
            source: root.icon_source
            color: root.text_color_selected if root.is_selected else root.text_color_normal
            allow_stretch: True
            keep_ratio: True
        
        Label:
            size_hint_x: 1
            text: root.tab_text
            font_size: dp(16)
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            color: root.text_color_selected if root.is_selected else root.text_color_normal
            opacity: 1 if root.parent.parent.is_expanded else 0
            size_hint_x: 1 if root.parent.parent.is_expanded else 0

<Sidebar>:
    orientation: 'vertical'
    size_hint_x: 0.35 if self.is_expanded else 0.08
    padding: dp(2)
    spacing: dp(2)
    canvas.before:
        Color:
            rgba: self.sidebar_bg_color
        Rectangle:
            pos: self.pos
            size: self.size
    
    # Space oben hinzufügen
    Widget:
        size_hint_y: 0.1
    
    # Tabs Layout - mit flex-grow in der Mitte
    BoxLayout:
        id: tabs_layout
        orientation: 'vertical'
        size_hint_y: 0.7
        spacing: dp(5)
        
        TabButton:
            tab_key: "sidebar.connection"
            icon_source: "ui/assets/icons/connection.ico"
            
        TabButton:
            tab_key: "sidebar.devices"
            icon_source: "ui/assets/icons/devices.ico"
            
        TabButton:
            tab_key: "sidebar.account"
            icon_source: "ui/assets/icons/account.ico"
            
        TabButton:
            tab_key: "sidebar.settings"
            icon_source: "ui/assets/icons/settings.ico"
            
        TabButton:
            tab_key: "sidebar.files"
            icon_source: "ui/assets/icons/files.ico"
            
        TabButton:
            tab_key: "sidebar.trend"
            icon_source: "ui/assets/icons/trend.ico"
            
        TabButton:
            tab_key: "sidebar.help"
            icon_source: "ui/assets/icons/help.ico"
            
        TabButton:
            tab_key: "sidebar.info"
            icon_source: "ui/assets/icons/info.ico"
    
    # Flex-Space für die vertikale Zentrierung
    Widget:
        size_hint_y: 0.12
    
    # Reduzieren-Button am unteren Rand
    Button:
        size_hint_y: 0.08
        text: _("sidebar.collapse") if root.is_expanded else _("sidebar.expand")
        background_normal: ''
        background_color: root.button_bg_color
        color: root.text_color
        on_release: root.toggle_sidebar()